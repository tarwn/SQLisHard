{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "dist",
    "types": ["node", "@playwright/test"]
  },
  "include": ["tests", "playwright.config.ts"],
  "exclude": ["node_modules", "dist"]
}
